# PostgreSQL local: import nguyên trạng mayday_backup.sql trước khi chạy ứng dụng.
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/mayday?schema=public
PORT=3000
WEB_ORIGIN=http://localhost:5173
# SESSION_FILE mặc định: .data/sessions.json tại thư mục gốc dự án.
# UPLOAD_DIR mặc định: .data/uploads; kho ảnh private của API đặc tả, không public static.
# Chỉ đặt TEST_DATABASE_URL cho database mayday_test_* dùng một lần.
