# PostgreSQL local: import nguyên trạng mayday_backup.sql trước khi chạy ứng dụng.
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/mayday?schema=public
PORT=3000
WEB_ORIGIN=http://localhost:5173
# SESSION_FILE mặc định: .data/sessions.json tại thư mục gốc dự án.
# Local mặc định SESSION_STORE=file. Vercel mặc định SESSION_STORE=redis và cần kho dùng chung.
# Kết nối Upstash Redis vào project API trên Vercel, rồi redeploy:
# SESSION_STORE=redis
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-write-enabled-token
# Hoặc dùng REDIS_URL=rediss://... thay cho cặp REST; KV_REST_API_URL/TOKEN cũng được hỗ trợ.
# SESSION_KEY_PREFIX=mayday:production:session:v1: (tùy chọn; tách production và preview nếu chung Redis)
# UPLOAD_DIR mặc định: .data/uploads; kho ảnh private của API đặc tả, không public static.
# Chỉ đặt TEST_DATABASE_URL cho database mayday_test_* dùng một lần.
