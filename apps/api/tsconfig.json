{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node", "lib": ["ES2022"],
    "strict": true, "experimentalDecorators": true, "emitDecoratorMetadata": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist", "sourceMap": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"], "exclude": ["node_modules", "dist"]
}
